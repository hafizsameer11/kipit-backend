# Copy to .env and fill values. Never commit real live keys.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kipit:kipit@localhost:5432/kipit?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
DEMO_OTP=123456

# Email — Hostinger SMTP (activate Resend later with EMAIL_PROVIDER=resend + RESEND_API_KEY)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Kipit <noreply@kipit.pejul.com>"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@kipit.pejul.com
SMTP_PASS=
RESEND_API_KEY=

PAYMENTS_MODE=sandbox
# Monnify mock until keys are set. Paystack uses real API whenever PAYSTACK_SECRET_KEY is set.
PAYMENTS_MOCK=true
# Optional override: PAYSTACK_MOCK=true forces Paystack sandbox mock even with keys
APP_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:8080

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Test: sk_test_… / pk_test_…  | Live: sk_live_… / pk_live_…
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Prembly KYC (BVN / NIN) — latest docs: x-api-key only, no app-id
# https://docs.prembly.com/docs/authentication
# https://docs.prembly.com/docs/bvn-basic-copy
# https://docs.prembly.com/docs/national-id-basic-1
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
# Optional: PREMBLY_MOCK=true forces local simulation even with a key
PREMBLY_MOCK=
