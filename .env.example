# Copy to .env and fill values. Never commit real live keys.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kipit:kipit@localhost:5432/kipit?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
DEMO_OTP=123456

# Email — Resend (all production mail). Domain in EMAIL_FROM must be verified in Resend.
# https://resend.com/domains  ·  https://resend.com/api-keys
EMAIL_PROVIDER=resend
EMAIL_FROM="Kipit <noreply@your-verified-domain.com>"
RESEND_API_KEY=re_xxxxxxxx

# Legacy SMTP (only if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

PAYMENTS_MODE=sandbox
# Monnify mock until keys are set. Paystack uses real API whenever PAYSTACK_SECRET_KEY is set.
PAYMENTS_MOCK=true
# Optional override: PAYSTACK_MOCK=true forces Paystack sandbox mock even with keys
# Production example:
# APP_BASE_URL=https://api.a-kipbackend.online
# WEB_APP_URL=https://a-kipbackend.online
APP_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:8080

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# Test: sk_test_â€¦ / pk_test_â€¦  | Live: sk_live_â€¦ / pk_live_â€¦
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Prembly KYC (BVN / NIN) â€” latest docs: x-api-key only, no app-id
# https://docs.prembly.com/docs/authentication
# https://docs.prembly.com/docs/bvn-basic-copy
# https://docs.prembly.com/docs/national-id-basic-1
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
# Optional: PREMBLY_MOCK=true forces local simulation even with a key
PREMBLY_MOCK=

# Ask AI â€” OpenAI-compatible LLM (leave empty to use rule-based fallback)
# Works with OpenAI, or any compatible proxy via OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional — Expo push rate limits (expo.dev ? Access tokens)
EXPO_ACCESS_TOKEN=

# Google Sign-In (Web) — OAuth 2.0 Client ID of type "Web application"
# Same value as VITE_GOOGLE_CLIENT_ID on the consumer web app
GOOGLE_CLIENT_ID=

